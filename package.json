  },
  "author": "Roman Golchuk <golchukroman@gmail.com> (https://www.roman-golchuk.site/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5tronciy/websockets-ui.git"
  },
  "bugs": {
    "url": "https://github.com/5tronciy/websockets-ui/issues"
  },
  "keywords": [
    "websocket",
    "battleship",
    "game"
  ],
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^18.16.0",
    "@types/ws": "^8.5.4",
    "nodemon": "^2.0.16",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "ws": "^8.8.0",
    "uuid": "^9.0.0"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
