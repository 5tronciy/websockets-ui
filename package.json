{
    "name": "ws_task",
    "version": "1.0.0",
    "description": "Template for the WebSocket remote control task",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "start": "node ./dist/index.js",
        "start:dev": "nodemon",
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "author": "Andrei Auchynnikau",
    "keywords": [],
    "license": "ISC",
    "devDependencies": {
        "@types/node": "^18.16.0",
        "@types/ws": "^8.5.4",
        "nodemon": "^2.0.16",
        "typescript": "^5.0.4"
    },
    "dependencies": {
        "ws": "^8.8.0"
    },
    "nodemonConfig": {
        "watch": ["src"],
        "ext": "ts",
        "exec": "npm run build && npm run start"
    }
}